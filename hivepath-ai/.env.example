# HivePath AI - environment configuration
#
#   cp .env.example .env
#
# Every value below is optional; the defaults shown are what the service uses
# when the variable is absent. The service starts and solves routes with no
# credentials at all - features that need a key degrade to documented fallbacks
# rather than failing.
#
# NEVER commit the real .env. It is covered by .gitignore.

# ---- Service ---------------------------------------------------------------
SERVICE_NAME=hivepath
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # CRITICAL | ERROR | WARNING | INFO | DEBUG
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Credentials -----------------------------------------------------------
# Google Maps Platform key. Enables real road distances (Distance Matrix) and
# Street View imagery. Without it the solver uses haversine distances.
# Restrict the key to the APIs and referrers you actually use.
GOOGLE_MAPS_API_KEY=

# Optional. Street View and Distance Matrix are both Google Maps Platform and
# normally share one key. Set this only to scope them to separate keys.
GOOGLE_STREET_VIEW_API_KEY=

# OpenAI key for the vision model that scores curbside accessibility.
# Without it, accessibility analysis returns a neutral score of 50.
OPENAI_API_KEY=
VLM_MODEL=gpt-4o-mini

# ---- Infrastructure --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
BASE_BACKEND_URL=http://localhost:8000

# ---- Solver defaults -------------------------------------------------------
SOLVER_TIME_LIMIT_SEC=8

# Applies to the CP-SAT backend only. The default guided-local-search routing
# metaheuristic is single-threaded, so raising this alone will not speed up a
# solve; increase SOLVER_TIME_LIMIT_SEC instead.
SOLVER_NUM_WORKERS=8
SOLVER_DEFAULT_SPEED_KMPH=40.0
SOLVER_DEFAULT_SERVICE_MIN=5

# Cost charged for leaving a stop unserved, multiplied by the stop's priority.
SOLVER_DROP_PENALTY_PER_PRIORITY=5000

# Fraction of the drop penalty added per point of missing accessibility
# (0-100 scale). At 0.002 a completely inaccessible stop costs 20% more to
# skip than an easy one, so the solver prefers to keep it in the plan.
SOLVER_ACCESS_PENALTY_WEIGHT=0.002

# ---- Artefact locations ----------------------------------------------------
# Defaults are resolved relative to the project root.
# MODELS_DIR=models
# ARTIFACTS_DIR=mlartifacts
# DATA_DIR=data
