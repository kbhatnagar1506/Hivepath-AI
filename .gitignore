# ---- Secrets ---------------------------------------------------------------
# Never commit real credentials. .env.example is the template and IS tracked.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# ---- Node / Next.js --------------------------------------------------------
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- Data and artefacts ----------------------------------------------------
# Large or regenerable outputs. Trained checkpoints under mlartifacts/ and
# models/ are tracked deliberately - the service loads them at runtime.
*.log
actuals.log
*.sqlite3
*.db
mlruns/
.ipynb_checkpoints/

# ---- Editors and OS --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
